APP_NAME=nosk
ENVIRONMENT=dev
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./nosk.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=20160
VERIFY_TOKEN_EXPIRE_MINUTES=2880
RESET_TOKEN_EXPIRE_MINUTES=60
# console = log emails to stdout, smtp = deliver via SMTP_* settings
EMAIL_BACKEND=console
SMTP_SENDER=noreply@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
MEDIA_ROOT=./media
MAX_UPLOAD_BYTES=10485760
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANONYMOUS_PER_MINUTE=60
RATE_LIMIT_AUTHENTICATED_PER_MINUTE=600
SNAPSHOT_INTERVAL_MINUTES=15
