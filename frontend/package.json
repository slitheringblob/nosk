{
  "name": "nosk-frontend",
  "private": true,
  "type": "module",
  "description": "nosk web client. No build step: vendored libraries live in lib/.",
  "scripts": {
    "serve": "python3 -m http.server 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "vendor": "node scripts/vendor.mjs",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\""
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "dompurify": "3.1.6",
    "fake-indexeddb": "6.0.0",
    "jsdom": "24.1.1",
    "katex": "0.16.11",
    "marked": "12.0.2",
    "prettier": "3.3.3",
    "vitest": "2.0.5"
  }
}
